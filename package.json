{
  "name": "@agntn/credentials",
  "version": "0.0.2",
  "description": "Find the tokens your CLIs and environment already hold, for GitHub, GitLab, Gitea, Gitee, Sourcehut, Bitbucket, Azure DevOps, Pushin, Cursor Origin, GitCafe, Tangled and Cloudflare.",
  "keywords": [
    "agents",
    "azure-devops",
    "bitbucket",
    "cloudflare",
    "credentials",
    "cursor-origin",
    "gitcafe",
    "gitea",
    "gitee",
    "github",
    "gitlab",
    "pushin",
    "sourcehut",
    "tangled",
    "token"
  ],
  "homepage": "https://github.com/agntn/credentials#readme",
  "bugs": "https://github.com/agntn/credentials/issues",
  "license": "MIT",
  "author": "oritwoen (https://github.com/oritwoen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agntn/credentials.git"
  },
  "bin": {
    "credentials": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "extensions/omp",
    "extensions/pi"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./ai": {
      "types": "./dist/ai.d.mts",
      "import": "./dist/ai.mjs"
    },
    "./azure-devops": {
      "types": "./dist/azure-devops.d.mts",
      "import": "./dist/azure-devops.mjs"
    },
    "./bitbucket": {
      "types": "./dist/bitbucket.d.mts",
      "import": "./dist/bitbucket.mjs"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.mts",
      "import": "./dist/cloudflare.mjs"
    },
    "./cursor-origin": {
      "types": "./dist/cursor-origin.d.mts",
      "import": "./dist/cursor-origin.mjs"
    },
    "./gitcafe": {
      "types": "./dist/gitcafe.d.mts",
      "import": "./dist/gitcafe.mjs"
    },
    "./gitea": {
      "types": "./dist/gitea.d.mts",
      "import": "./dist/gitea.mjs"
    },
    "./gitee": {
      "types": "./dist/gitee.d.mts",
      "import": "./dist/gitee.mjs"
    },
    "./github": {
      "types": "./dist/github.d.mts",
      "import": "./dist/github.mjs"
    },
    "./gitlab": {
      "types": "./dist/gitlab.d.mts",
      "import": "./dist/gitlab.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.mts",
      "import": "./dist/mcp.mjs"
    },
    "./pushin": {
      "types": "./dist/pushin.d.mts",
      "import": "./dist/pushin.mjs"
    },
    "./sourcehut": {
      "types": "./dist/sourcehut.d.mts",
      "import": "./dist/sourcehut.mjs"
    },
    "./tangled": {
      "types": "./dist/tangled.d.mts",
      "import": "./dist/tangled.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild",
    "dev": "obuild --stub",
    "lint": "pnpm build && vp lint && vp fmt --check",
    "fmt": "pnpm build && vp lint --fix && vp fmt",
    "typecheck": "tsc --noEmit --skipLibCheck && pnpm build && tsc -p tsconfig.extensions.json && tsc -p test/tsconfig.json",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@agntn/tools": "catalog:deps",
    "@modelcontextprotocol/server": "catalog:deps"
  },
  "devDependencies": {
    "@agntn/ox": "catalog:dev",
    "@earendil-works/pi-coding-agent": "catalog:dev",
    "@modelcontextprotocol/client": "catalog:dev",
    "@oh-my-pi/pi-coding-agent": "catalog:dev",
    "@types/node": "catalog:dev",
    "ai": "catalog:dev",
    "obuild": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.87.1 <2",
    "@oh-my-pi/pi-coding-agent": ">=18.4.2 <19",
    "ai": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.10.1",
  "omp": {
    "extensions": [
      "./extensions/omp/credentials.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./extensions/pi/credentials.ts"
    ]
  }
}
